{
  "name": "number-string",
  "version": "2.0.1",
  "description": "Functions to format number to string",
  "main": "dist/app.js",
  "type": "module",
  "author": "Tony Brix <Tony@Brix.ninja>",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "check-coverage": "node --experimental-test-coverage --import tsx --test test/*.test.ts",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UziTech/number-string.git"
  },
  "keywords": [
    "number",
    "string",
    "tostring",
    "format"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UziTech/number-string/issues"
  },
  "homepage": "https://github.com/UziTech/number-string#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  }
}
